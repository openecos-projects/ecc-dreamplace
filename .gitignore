# Test sources live in tests/ (test/ holds design benchmarks). Locally built test
# executables land next to their sources, e.g.
# tests/ops/abacus_legalize_unittest/abacus_unittest; ignore only those binaries.
/tests/ops/*_unittest/*_unittest
glog_dump.log
surrogate_cache/

# Internal planning and experiment records are deliberately not versioned:
# governance/design plans under docs/ and the per-campaign markdown reports
# mixed into the regression tree. Keep the regression indexes.
docs/flow_governance/*.md
docs/buffering/*.md
docs/backend_governance/*.md
test/regression/**/*.md
!test/regression/README.md
!test/regression/iccad24/README.md
# Per-campaign paper/QoR tables are personal experiment records, not test assets.
test/regression/**/paper/
*.png
dreamplace/configure.py
.codex*
.direnv
result

# Xplace gpugr build artifacts (out-of-source build tree; the in-submodule
